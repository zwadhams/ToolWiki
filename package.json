{
  "name": "tool-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "review:status": "node scripts/review-status.mjs",
    "mcp": "node --experimental-strip-types mcp/server.ts",
    "test:mcp": "node --test tests/mcp/*.test.mjs",
    "verify": "pnpm check && pnpm test && pnpm build && node scripts/check-site.mjs && node scripts/check-knowledge.mjs && pnpm test:mcp"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.2",
    "@modelcontextprotocol/server": "2.4.0",
    "astro": "7.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/inspector": "2.14.0",
    "@types/node": "24.10.0",
    "github-slugger": "2.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  }
}
