---
import { getCollection } from 'astro:content';
import { publishedTools, builderData } from '../lib/tool-data.mjs';
import { buildKnowledge } from '../lib/knowledge-export.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('docs');
const tools = publishedTools(entries);
const data = builderData(tools);
const site = new URL(base + '/', import.meta.env.SITE).href;
const { snapshot } = buildKnowledge(entries, site);
const citations = new Map(snapshot.documents.map(({ id, title, url, revision, evidence }) => [id, { id, title, url, revision, evidence }]));
const exportData = { ...data, tools: data.tools.map(tool => ({ ...tool, citation: citations.get(tool.id) })), snapshotRevision: snapshot.revision, sourceUrl: new URL('analysis-suite/', site).href };
---
<system-builder data-base={base} data-pagefind-ignore>
  <div class="suite-intro">
    <p class="catalog-intro">Choose a language and the material you have. Add details to narrow the suggestions for each part of your system.</p>
    <p class="suite-muted">This page suggests tools; it does not run them. Your system description saves in this browser and can be exported. Tool selections are temporary; bookmark the comparison page to keep them.</p>
    <p><a href={`${base}/guides/choosing-and-recording-tools/`}>Record your choice and unresolved prerequisites</a> before running a tool.</p>
    <details class="suggestion-scope"><summary>Suggestion scope: {data.tools.length} of {data.totalTools} catalog tools</summary>
      <p>Suggestions use reviewed workflows. These tools are not matched yet but may still be suitable:</p>
      <ul>{tools.filter(tool => !tool.analysisWorkflows.length).map(tool => <li><a href={`${base}/${tool.id}/`}>{tool.title}</a></li>)}</ul>
    </details>
  </div>
  <div data-builder-root><p>Loading your system editor...</p></div>
  <noscript><p>Enable JavaScript to describe and save a system. You can also <a href={`${base}/`}>browse the tool catalog</a> and read the tool notes.</p></noscript>
  <script type="application/json" data-builder-data set:html={JSON.stringify(exportData).replace(/</g, '\u003c')} />
</system-builder>
<script>
  import '../lib/system-builder-ui.mjs';
</script>
