---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tools = (await getCollection('docs', ({ data }) => !!data.tool && !data.draft))
  .map(({ id, data }) => ({ id, title: data.title, ...data.tool! }));
const languages = [...new Set(tools.flatMap(t => t.languages))].filter(l => l !== 'Language independent').sort();
const data = { tools: tools.filter(t => t.analysisWorkflows.length), languages, totalTools: tools.length };
---
<system-builder data-base={base} data-pagefind-ignore>
  <div class="suite-intro">
    <p class="catalog-intro">Describe the parts of your system and what you want to investigate. Explore tool candidates, understand their requirements, and see where more information is needed.</p>
    <p class="suite-muted">Your description stays in this browser. Export a system file to keep a copy or use it elsewhere. This page suggests tools; it does not run analyses.</p>
  </div>
  <div data-builder-root><p>Loading your system editor...</p></div>
  <noscript><p>Enable JavaScript to describe and save a system. You can also <a href={`${base}/`}>browse the tool catalog</a> and read the tool notes.</p></noscript>
  <script type="application/json" data-builder-data set:html={JSON.stringify(data).replace(/</g, '\u003c')} />
</system-builder>
<script>
  import '../lib/system-builder-ui.mjs';
</script>
